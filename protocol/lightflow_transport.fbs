namespace lightflow.transport;

enum MessageKind : ushort {
  WorkflowRegionRequest = 1,
  WorkflowRegionResponse = 2,
  WorkflowPatch = 3,
  WorkflowValidation = 4,
  PreviewFrame = 5,
  RunEvent = 6
}

enum NodeKind : ushort {
  WorkflowInput = 1,
  McpTool = 2,
  StateTransform = 3,
  RunState = 4,
  PreviewSink = 5,
  WebComponentSlot = 6
}

enum PatchOpKind : ushort {
  AddNode = 1,
  MoveNode = 2,
  DeleteNode = 3,
  Connect = 4,
  Disconnect = 5,
  UpdateNode = 6
}

struct Vec2 {
  x:float;
  y:float;
}

struct Rect {
  x:float;
  y:float;
  width:float;
  height:float;
}

table PortRef {
  node:string (required);
  port:string (required);
}

table WorkflowRegion {
  rect:Rect;
  zoom:float = 1.0;
  limit:uint = 500;
  cursor:string;
}

table WorkflowNode {
  id:string (required);
  kind:NodeKind;
  title:string (required);
  position:Vec2;
  component:string;
}

table WorkflowEdge {
  id:string (required);
  from:PortRef (required);
  to:PortRef (required);
}

table WorkflowRegionRequest {
  workflow_id:string (required);
  region:WorkflowRegion (required);
  revision:string;
}

table WorkflowRegionResponse {
  workflow_id:string (required);
  revision:string (required);
  nodes:[WorkflowNode];
  edges:[WorkflowEdge];
  total_estimate:ulong;
  next_cursor:string;
}

table WorkflowPatchOp {
  kind:PatchOpKind;
  node:WorkflowNode;
  node_id:string;
  position:Vec2;
  from:PortRef;
  to:PortRef;
}

table WorkflowPatch {
  workflow_id:string (required);
  base_revision:string (required);
  ops:[WorkflowPatchOp];
}

table ValidationIssue {
  severity:string (required);
  code:string (required);
  message:string (required);
  node_id:string;
}

table WorkflowValidation {
  workflow_id:string (required);
  revision:string (required);
  issues:[ValidationIssue];
}

table PreviewFrame {
  run_id:string (required);
  node_id:string (required);
  sequence:ulong;
  timestamp_ms:ulong;
  mime:string (required);
  width:uint;
  height:uint;
  bytes:[ubyte] (required);
}

table RunEvent {
  run_id:string (required);
  sequence:ulong;
  event_type:string (required);
  payload:[ubyte];
}

table TransportEnvelope {
  request_id:ulong;
  kind:MessageKind;
  workflow_region_request:WorkflowRegionRequest;
  workflow_region_response:WorkflowRegionResponse;
  workflow_patch:WorkflowPatch;
  workflow_validation:WorkflowValidation;
  preview_frame:PreviewFrame;
  run_event:RunEvent;
}

root_type TransportEnvelope;
